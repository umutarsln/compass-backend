# Uygulama (Railway public domain: https://<servis>.up.railway.app)
APP_PUBLIC_URL=
FRONTEND_SUCCESS_URL=
FRONTEND_FAIL_URL=
CORS_ORIGINS=https://compass-front-admin.vercel.app,https://www.compassreklam.com,https://www.ilevgroup.com

# PostgreSQL — Railway Postgres servisi bağlandığında DATABASE_URL otomatik gelir
DATABASE_PUBLIC_URL=
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SYNCHRONIZE=true

# Redis — Railway Redis servisi bağlandığında REDIS_URL otomatik gelir
REDIS_URL=
REDIS_PUBLIC_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Yerel geliştirmede Redis yoksa: CACHE_STORE=memory
CACHE_STORE=

# İlk admin hesabı (backend açılışında otomatik oluşturulur/güncellenir)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRSTNAME=Yönetici
ADMIN_SEED_LASTNAME=Admin

# Varsayılan kart sağlayıcısı (IYZICO | QNBPAY)
PAYMENT_PROVIDER_DEFAULT=QNBPAY

# Iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
IYZICO_PAYMENT_CALLBACK_PATH=/payments/iyzico/callback
IYZICO_PAYMENT_WEBHOOK_PATH=/payments/iyzico/webhook

# QNBpay (ayarlar çoğunlukla DB payment_settings üzerinden; env yedek)
QNBPAY_BASE_URL=https://test.qnbpay.com.tr/ccpayment
QNBPAY_APP_ID=
QNBPAY_APP_SECRET=
QNBPAY_MERCHANT_KEY=
QNBPAY_MERCHANT_ID=
QNBPAY_RETURN_PATH=/payments/qnbpay/return
QNBPAY_CANCEL_PATH=/payments/qnbpay/cancel
QNBPAY_WEBHOOK_PATH=/payments/qnbpay/webhook
QNBPAY_SALE_WEBHOOK_KEY=
