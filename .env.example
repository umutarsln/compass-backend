# Uygulama
APP_PUBLIC_URL=
FRONTEND_SUCCESS_URL=
FRONTEND_FAIL_URL=

# Varsayılan kart sağlayıcısı (IYZICO | QNBPAY)
PAYMENT_PROVIDER_DEFAULT=IYZICO

# Iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
IYZICO_PAYMENT_CALLBACK_PATH=/payments/iyzico/callback
IYZICO_PAYMENT_WEBHOOK_PATH=/payments/iyzico/webhook

# QNBpay (ayarlar çoğunlukla DB payment_settings üzerinden; env yedek)
QNBPAY_BASE_URL=https://test.qnbpay.com.tr/ccpayment
QNBPAY_APP_ID=
QNBPAY_APP_SECRET=
QNBPAY_MERCHANT_KEY=
QNBPAY_MERCHANT_ID=
QNBPAY_RETURN_PATH=/payments/qnbpay/return
QNBPAY_CANCEL_PATH=/payments/qnbpay/cancel
QNBPAY_WEBHOOK_PATH=/payments/qnbpay/webhook
QNBPAY_SALE_WEBHOOK_KEY=
