  },
  "item": [
    {
      "name": "Create Category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Elektronik\",\n  \"description\": \"Elektronik ürünler kategorisi\",\n  \"parentId\": null,\n  \"imageId\": null,\n  \"seoTitle\": \"Elektronik Ürünler\",\n  \"seoDescription\": \"Elektronik ürünler için kategori\",\n  \"seoKeywords\": [\"elektronik\", \"teknoloji\"],\n  \"isActive\": true,\n  \"displayOrder\": 0\n}"
        },
        "url": {
          "raw": "{{base_url}}/categories",
          "host": ["{{base_url}}"],
          "path": ["categories"]
        }
      }
    },
    {
      "name": "Get All Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/categories",
          "host": ["{{base_url}}"],
          "path": ["categories"]
        }
      }
    },
    {
      "name": "Get Categories Tree",
      "request": {
        "method": "GET",
        "header": [],
