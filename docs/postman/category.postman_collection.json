          "raw": "{{base_url}}/categories/tree",
          "host": ["{{base_url}}"],
          "path": ["categories", "tree"]
        }
      }
    },
    {
      "name": "Get Category by ID",
      "request": {
        "method": "GET",
        "header": [],
