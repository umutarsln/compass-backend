            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Güncellenmiş Kategori\",\n  \"description\": \"Yeni açıklama\",\n  \"isActive\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/categories/:id",
          "host": ["{{base_url}}"],
          "path": ["categories", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "uuid"
            }
          ]
        }
      }
    },
    {
      "name": "Delete Category",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/categories/:id",
          "host": ["{{base_url}}"],
          "path": ["categories", ":id"],
