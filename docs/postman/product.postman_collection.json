{
  "info": {
    "name": "Product Module",
    "description": "E-Ticaret Backend - Product Modülü API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"SIMPLE\",\n  \"name\": \"Örnek Ürün\",\n  \"description\": \"# Ürün Açıklaması\\n\\nDetaylı bilgi...\",\n  \"basePrice\": 99.99,\n  \"sku\": \"PRD-001\",\n  \"isActive\": true,\n  \"isFeatured\": false,\n  \"isOnSale\": false,\n  \"discountPercent\": null,\n  \"seoTitle\": \"Örnek Ürün - SEO\",\n  \"seoDescription\": \"SEO açıklaması\",\n  \"seoKeywords\": [\"ürün\", \"e-ticaret\"],\n  \"categoryIds\": [],\n  \"tagIds\": []\n}"
        },
        "url": {
          "raw": "{{base_url}}/products",
          "host": ["{{base_url}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products?type=SIMPLE&categoryId=uuid",
          "host": ["{{base_url}}"],
          "path": ["products"],
          "query": [
            {
              "key": "type",
              "value": "SIMPLE"
            },
            {
              "key": "categoryId",
              "value": "uuid"
            }
          ]
        }
      }
    },
    {
      "name": "Get Product by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products/:id",
          "host": ["{{base_url}}"],
          "path": ["products", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "uuid"
            }
          ]
        }
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Güncellenmiş Ürün\",\n  \"basePrice\": 149.99,\n  \"isOnSale\": true,\n  \"discountPercent\": 10.5,\n  \"categoryIds\": [\"uuid\"],\n  \"tagIds\": [\"uuid\"]\n}"
        },
        "url": {
          "raw": "{{base_url}}/products/:id",
          "host": ["{{base_url}}"],
          "path": ["products", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "uuid"
            }
          ]
        }
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/:id",
          "host": ["{{base_url}}"],
          "path": ["products", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "uuid"
            }
          ]
        }
      }
    }
  ]
}
